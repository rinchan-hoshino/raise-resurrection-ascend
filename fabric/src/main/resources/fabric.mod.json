  "authors": ["RinChan"],
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinchan.raiseresurrectionascend.fabric.RaiseResurrectionAscendFabric"
    ],
    "client": [
      "dev.rinchan.raiseresurrectionascend.client.fabric.RaiseResurrectionAscendFabricClient"
    ]
  },
  "mixins": [
    "raise_resurrection_ascend.mixins.json",
    "raise_resurrection_ascend.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=0.155.2"
